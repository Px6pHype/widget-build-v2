<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Запрос погоды Open-Meteo -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ближайшие события на сегодня -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Последние известные координаты для погоды (приблизительная геолокация) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlassWidgets">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Виджет 1: часы и дата (2x1) -->
        <receiver
            android:name=".ClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_clock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_info" />
        </receiver>

        <!-- Виджет 2: календарь + погода + события (4x2) -->
        <receiver
            android:name=".CalendarWidgetProvider"
            android:exported="true"
            android:label="@string/widget_calendar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Смена даты/времени/пояса/языка: эти системные широковещательные
                     сообщения разрешены для манифеста и на Android 8+ -->
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <!-- Виджет 3: музыкальный плеер (4x1) -->
        <receiver
            android:name=".MusicWidgetProvider"
            android:exported="true"
            android:label="@string/widget_music_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_widget_info" />
        </receiver>

        <!-- Источник данных о MediaSession (Spotify, Яндекс Музыка, YouTube Music и др.).
             Для стороннего приложения это единственный легальный доступ к активным
             сессиям. Система сама подключает сервис, когда пользователь выдаст доступ
             к уведомлениям: BIND_NOTIFICATION_LISTENER_SERVICE запрошен атрибутом ниже. -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
