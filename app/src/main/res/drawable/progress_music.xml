<?xml version="1.0" encoding="utf-8"?>
<!-- Полоса прогресса музыкального виджета: скруглённый фон и скруглённая
     белая полоса заполнения (clip растёт слева направо по уровню). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/widget_today_background" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="@color/widget_text_primary" />
            </shape>
        </clip>
    </item>
</layer-list>
